#include <iostream>
#include <cmath>
using namespace std;

int main()
{
	double peso;
	double dollar;
	double euro;
	double yuan;
	double koruna;
	double krone;
	double sheqel;
	double dinar;

	cout << "Enter Philippine Peso: ";
	cin >> peso;

	dollar = peso / 43.33089;
	euro = dollar * 0.734719;
	yuan = dollar * 6.346934;
	koruna = dollar * 18.77263;
	krone = dollar * 5.449007;
	sheqel = dollar * 3.726334;
	dinar = dollar * 0.274588;

	cout << "\nThe amount is equivalent to: " << endl;
	cout << "US Dollar: " << dollar << endl;
	cout << "Euro: " << euro << endl;
	cout << "Yuan: " << yuan << endl;
	cout << "Koruna: " << koruna << endl;
	cout << "Krone: " << krone << endl;
	cout << "Sheqel: " << sheqel << endl;
	cout << "Dinar: " << dinar << endl;

	return 0;

}
